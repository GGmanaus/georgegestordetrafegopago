<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestor de Tráfego Pago | Consultoria</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Gestor de Tráfego Pago</h1>
        <p>Especialista em Google Ads, Meta Ads e Estratégias de Conversão</p>
    </header>

    <section class="sobre">
        <h2>Sobre Mim</h2>
        <p>Sou gestor de tráfego pago especializado em aumentar vendas e gerar leads qualificados através de campanhas estratégicas e otimizadas.</p>
    </section>

    <section class="consulta">
        <h2>Agende sua Consulta</h2>

        <form id="formConsulta">
            <input type="text" id="nome" placeholder="Seu Nome" required>
            <input type="email" id="email" placeholder="Seu Email" required>
            <input type="tel" id="telefone" placeholder="Seu Telefone" required>
            <input type="date" id="data" required>
            <button type="submit">Agendar Consulta</button>
        </form>

        <div id="mensagem"></div>
    </section>

    <section class="contato">
        <h2>Contato</h2>
        <p><strong>Email:</strong> seuemail@email.com</p>
        <p><strong>Telefone:</strong> (11) 99999-9999</p>
    </section>

    <footer>
        <p>© 2026 - Gestor de Tráfego Pago | Todos os direitos reservados</p>
    </footer>

<script src="script.js"></script>
</body>
</html>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #0f172a;
    color: white;
    text-align: center;
}

header {
    padding: 40px 20px;
    background: linear-gradient(90deg, #2563eb, #7c3aed);
}

h1 {
    font-size: 2.5rem;
}

section {
    padding: 40px 20px;
}

.sobre {
    background-color: #1e293b;
}

.consulta {
    background-color: #0f172a;
}

form {
    display: flex;
    flex-direction: column;
    max-width: 400px;
    margin: 20px auto;
    gap: 10px;
}

input {
    padding: 10px;
    border-radius: 5px;
    border: none;
}

button {
    padding: 12px;
    border: none;
    background-color: #2563eb;
    color: white;
    font-weight: bold;
    cursor: pointer;
    border-radius: 5px;
    transition: 0.3s;
}

button:hover {
    background-color: #1d4ed8;
}

.contato {
    background-color: #1e293b;
}

footer {
    padding: 20px;
    background-color: #111827;
}
document.getElementById("formConsulta").addEventListener("submit", function(e) {
    e.preventDefault();

    const nome = document.getElementById("nome").value;
    const email = document.getElementById("email").value;
    const telefone = document.getElementById("telefone").value;
    const data = document.getElementById("data").value;

    const consulta = {
        nome,
        email,
        telefone,
        data
    };

    let consultas = JSON.parse(localStorage.getItem("consultas")) || [];
    consultas.push(consulta);

    localStorage.setItem("consultas", JSON.stringify(consultas));

    document.getElementById("mensagem").innerHTML =
        `<p style="color: #22c55e; margin-top: 10px;">
            Consulta agendada com sucesso!
        </p>`;

    document.getElementById("formConsulta").reset();
});

